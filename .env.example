# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
WASTEWISE_API_BASE_URL=https://harness-action-entail.ngrok-free.dev
WASTEWISE_API_KEY=
# Set these only if your backend requires authentication; confirm its header first.
WASTEWISE_API_KEY_HEADER=
WASTEWISE_API_KEY_PREFIX=

# Firebase login (Firebase Console → Project settings → Your apps → Web app → SDK config).
# These values are public identifiers, not secrets. When PROJECT_ID is set, the API
# proxy only answers signed-in users.
WASTEWISE_FIREBASE_API_KEY=
WASTEWISE_FIREBASE_AUTH_DOMAIN=
WASTEWISE_FIREBASE_PROJECT_ID=
WASTEWISE_FIREBASE_APP_ID=


# Rewards admin key from the backend owner. Server-side only: used once per user to create
# their backend member account (stored in the D1 database). Never expose it to the browser or Git.
WASTEWISE_REWARDS_ADMIN_KEY=
